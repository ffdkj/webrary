@startuml 系统架构图
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Microsoft YaHei
skinparam packageStyle rectangle

package "客户端 (Browser)" {
  [index.html\n主页面 SPA] as index_html
  [reader.html\n在线阅读器] as reader_html
  [app.js\n前端逻辑] as app_js
  [CSS / Vendor\nepub.js, pdf.js] as vendor
}

package "Spring Boot 后端 (Java 17)" {
  package "Controller 层" {
    [AuthController\n/api/auth/*] as auth_ctrl
    [BookController\n/api/books/*] as book_ctrl
    [BookshelfController\n/api/bookshelves/*] as shelf_ctrl
    [ZlibraryController\n/api/zlibrary/*] as zlib_ctrl
  }
  
  package "Service 层" {
    [AuthService] as auth_svc
    [BookService] as book_svc
    [BookshelfService] as shelf_svc
    [DownloadService] as dl_svc
    [EbookParserService] as epub_svc
    [ZlibraryService] as zlib_svc
  }
  
  package "Repository 层" {
    [UserRepository] as user_repo
    [BookRepository] as book_repo
    [BookshelfRepository] as shelf_repo
    [ShelfBookRepository] as shelfb_repo
    [ReadingProgressRepository] as rp_repo
    [UserZlibraryRepository] as uz_repo
    [ZlibraryConfigRepository] as zc_repo
  }
  
  package "Infrastructure" {
    [AuthInterceptor\n会话拦截] as interceptor
    [WebConfig\nCORS / 拦截器注册] as webcfg
    [StaticResourceConfig\n静态资源映射] as static_cfg
    [ZlibraryApiClient\nOkHttp 客户端] as zlib_client
  }
}

database "SQLite\n(webrary.db)" as sqlite {
  [users] as t_user
  [books] as t_book
  [bookshelves] as t_shelf
  [shelf_books] as t_sb
  [reading_progress] as t_rp
  [user_zlibrary] as t_uz
  [zlibrary_config] as t_zc
}

cloud "Z-Library API\n(外部服务)" as zlib_api

index_html --> auth_ctrl : HTTP/REST
reader_html --> book_ctrl : HTTP/REST
app_js --> shelf_ctrl : HTTP/REST

auth_ctrl --> auth_svc
book_ctrl --> book_svc
shelf_ctrl --> shelf_svc
zlib_ctrl --> zlib_svc
zlib_ctrl --> dl_svc

auth_svc --> user_repo
book_svc --> book_repo
book_svc --> epub_svc
shelf_svc --> shelf_repo
shelf_svc --> shelfb_repo
dl_svc --> zlib_svc
zlib_svc --> uz_repo
zlib_svc --> zlib_client

user_repo --> t_user
book_repo --> t_book
shelf_repo --> t_shelf
shelfb_repo --> t_sb
rp_repo --> t_rp
uz_repo --> t_uz
zc_repo --> t_zc

zlib_client --> zlib_api : HTTPS\n(Z-Library EAPI)

@enduml
