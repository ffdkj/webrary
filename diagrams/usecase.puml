@startuml 系统用例图
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Microsoft YaHei
left to right direction

actor 用户 as user

rectangle "Webrary 个人数字图书馆" {
  
  (注册/登录) as uc_login
  (管理书架) as uc_shelf
  (上传本地图书) as uc_upload
  (在线阅读) as uc_read
  (阅读进度追踪) as uc_progress
  
  (Z-Library登录) as uc_zlogin
  (Z-Library搜索) as uc_zsearch
  (Z-Library下载) as uc_zdl
  (浏览下载历史) as uc_hist
  
  uc_zlogin ..> uc_zsearch : <<include>>
  uc_zlogin ..> uc_zdl : <<include>>
  
  uc_zdl ..> uc_shelf : <<extend>>
  uc_zsearch ..> uc_zdl : <<extend>>
  
  uc_read ..> uc_progress : <<include>>
  uc_upload ..> uc_read : <<extend>>
}

user --> uc_login
user --> uc_shelf
user --> uc_upload
user --> uc_read
user --> uc_progress
user --> uc_zlogin
user --> uc_zsearch
user --> uc_zdl
user --> uc_hist

@enduml
